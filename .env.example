# Copy this file to .env only if you want live provider integrations.
MOCK_MODE=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=35
GROQ_MAX_TOKENS=512
GROQ_REASONING_EFFORT=low
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional remote Hindsight memory; without these, scans are stored in local JSON.
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=12
GEO_MEMORY_BANK_ID=geo-agent
